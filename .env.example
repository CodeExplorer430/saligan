# SALIGAN local development environment
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saligan
POSTGRES_USER=saligan
POSTGRES_PASSWORD=saligan_dev_password
DATABASE_URL=postgresql://saligan:saligan_dev_password@localhost:5432/saligan

SESSION_SECRET=replace-with-a-long-random-secret
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

SMTP_HOST=localhost
SMTP_PORT=1025
