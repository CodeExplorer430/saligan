# SALIGAN local development environment
COMPOSE_PROJECT_NAME=saligan
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api/v1
VITE_API_URL=http://localhost:3000/api/v1
API_PORT=3000
CORS_ORIGINS=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5433
POSTGRES_PORT=5432
POSTGRES_DB=saligan
POSTGRES_USER=saligan
POSTGRES_PASSWORD=saligan_dev_password
DATABASE_URL=postgresql://saligan:saligan_dev_password@localhost:5433/saligan

SESSION_SECRET=replace-with-a-long-random-secret
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@saligan.local

STORAGE_DRIVER=filesystem
STORAGE_ROOT=./storage
