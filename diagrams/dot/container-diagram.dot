digraph Containers {
  graph [rankdir=LR, fontsize=12, fontname="Arial", labelloc=t, label="SALIGAN Container Diagram"];
  node [shape=box, style="rounded,filled", fillcolor="#F8F8F8", color="#333333", fontname="Arial"];
  edge [fontname="Arial", color="#555555"];

  subgraph cluster_client {
    label="Client Device";
    color="#CCCCCC";
    WebPWA [fillcolor="#E8F1FF", label="Web PWA\nReact + Vite"];
    IndexedDB [fillcolor="#E8F1FF", label="IndexedDB\nDexie local drafts"];
    SyncQueue [fillcolor="#E8F1FF", label="Sync Queue\nPending offline operations"];
  }

  subgraph cluster_server {
    label="Self-hosted Server";
    color="#CCCCCC";
    API [fillcolor="#FFF4D6", label="API\nNestJS + Fastify + OpenAPI"];
    Domain [fillcolor="#FFF4D6", label="Domain Logic\nTime computation + authorization"];
    Exporters [fillcolor="#FFF4D6", label="Exporters\nPDF/DOCX/XLSX/CSV/ICS"];
    DB [shape=cylinder, fillcolor="#E8FFE8", label="PostgreSQL\nCanonical records"];
    Storage [shape=folder, fillcolor="#E8FFE8", label="File Storage\nExports + attachments"];
  }

  WebPWA -> IndexedDB [label="read/write local drafts"];
  IndexedDB -> SyncQueue [label="queue changes"];
  WebPWA -> API [label="HTTPS REST"];
  SyncQueue -> API [label="sync operations"];
  API -> Domain [label="validate rules"];
  API -> Exporters [label="generate files"];
  API -> DB [label="read/write"];
  API -> Storage [label="store files"];
}
