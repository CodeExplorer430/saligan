digraph Containers {
  graph [rankdir=LR, fontsize=12, fontname="Arial", labelloc=t, label="SALIGAN Sprint 0B Container and Workspace Diagram"];
  node [shape=box, style="rounded,filled", fillcolor="#F8F8F8", color="#333333", fontname="Arial"];
  edge [fontname="Arial", color="#555555"];

  subgraph cluster_client {
    label="Current browser application";
    color="#CCCCCC";
    Web [fillcolor="#E8F1FF", label="apps/web\nReact + Vite + Tailwind\nTanStack Router/Query\nPWA + Dexie placeholders"];
  }

  subgraph cluster_server {
    label="Current API and data";
    color="#CCCCCC";
    API [fillcolor="#FFF4D6", label="apps/api\nNestJS + Fastify\nGET /api/v1/health\nSwagger"];
    Database [fillcolor="#E8FFE8", label="packages/database\nDrizzle schema + migration"];
    DB [shape=cylinder, fillcolor="#E8FFE8", label="PostgreSQL 18\nHost 5433 → container 5432"];
  }

  subgraph cluster_packages {
    label="Current shared packages";
    color="#CCCCCC";
    Shared [label="packages/shared\nConstants + statuses"];
    Validation [label="packages/validation\nZod schemas"];
    UI [label="packages/ui\nPlaceholder boundary"];
    Config [label="packages/config\nTooling guidance"];
  }

  subgraph cluster_planned {
    label="Planned, not implemented";
    color="#999999";
    style=dashed;
    Auth [style="rounded,dashed", label="Auth + authorization"];
    Sync [style="rounded,dashed", label="Sync engine"];
    Exports [style="rounded,dashed", label="Exports + attachments"];
    Reviews [style="rounded,dashed", label="Review workflows"];
  }

  Web -> Shared;
  Web -> Validation;
  Web -> UI;
  API -> Shared;
  API -> Validation;
  Database -> DB [label="migrate / future query"];
  Config -> Web;
  Config -> API;
  Web -> Sync [style=dashed, label="future"];
  API -> Auth [style=dashed, label="future"];
  API -> Exports [style=dashed, label="future"];
  API -> Reviews [style=dashed, label="future"];
}
