digraph SystemContext {
  graph [rankdir=LR, fontsize=12, fontname="Arial", labelloc=t, label="SALIGAN Sprint 0B System Context"];
  node [shape=box, style="rounded,filled", fillcolor="#F8F8F8", color="#333333", fontname="Arial"];
  edge [fontname="Arial", color="#555555"];

  Developer [shape=oval, fillcolor="#E8F1FF", label="Developer"];
  FutureUser [shape=oval, fillcolor="#E8F1FF", label="Future SALIGAN User"];
  SALIGAN [fillcolor="#FFF4D6", label="SALIGAN\nPre-MVP Sprint 0B scaffold"];
  Postgres [shape=cylinder, fillcolor="#E8FFE8", label="PostgreSQL 18\nMigrated schema baseline"];
  Planned [style="rounded,dashed", label="Planned capabilities\nAuth, workflows, sync,\nexports, review, notifications"];

  Developer -> SALIGAN [label="runs, tests, extends"];
  SALIGAN -> Postgres [label="migration / future data"];
  FutureUser -> SALIGAN [style=dashed, label="future use"];
  SALIGAN -> Planned [style=dashed, label="future implementation"];
}
