<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SALIGAN" targetNamespace="https://saligan.local/bpmn">
  <process id="Process_DTR_Submission" name="SALIGAN Planned DTR Submission and Review — Not Implemented in Sprint 0B" isExecutable="false">
    <startEvent id="StartEvent_InternLogs" name="Intern logs DTR" />
    <task id="Task_SaveDraft" name="Save draft locally" />
    <exclusiveGateway id="Gateway_Online" name="Online?" />
    <task id="Task_Sync" name="Sync to server" />
    <task id="Task_Submit" name="Submit for review" />
    <task id="Task_Review" name="Supervisor reviews" />
    <exclusiveGateway id="Gateway_Decision" name="Decision" />
    <task id="Task_Approve" name="Approve record" />
    <task id="Task_RequestCorrection" name="Request correction" />
    <task id="Task_Correct" name="Intern corrects record" />
    <endEvent id="EndEvent_Approved" name="Approved export-ready record" />
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_InternLogs" targetRef="Task_SaveDraft" />
    <sequenceFlow id="Flow_2" sourceRef="Task_SaveDraft" targetRef="Gateway_Online" />
    <sequenceFlow id="Flow_3" sourceRef="Gateway_Online" targetRef="Task_Sync" name="yes" />
    <sequenceFlow id="Flow_4" sourceRef="Task_Sync" targetRef="Task_Submit" />
    <sequenceFlow id="Flow_5" sourceRef="Task_Submit" targetRef="Task_Review" />
    <sequenceFlow id="Flow_6" sourceRef="Task_Review" targetRef="Gateway_Decision" />
    <sequenceFlow id="Flow_7" sourceRef="Gateway_Decision" targetRef="Task_Approve" name="approve" />
    <sequenceFlow id="Flow_8" sourceRef="Task_Approve" targetRef="EndEvent_Approved" />
    <sequenceFlow id="Flow_9" sourceRef="Gateway_Decision" targetRef="Task_RequestCorrection" name="correction" />
    <sequenceFlow id="Flow_10" sourceRef="Task_RequestCorrection" targetRef="Task_Correct" />
    <sequenceFlow id="Flow_11" sourceRef="Task_Correct" targetRef="Task_SaveDraft" />
  </process>
</definitions>
